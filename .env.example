# Copy to .env and fill in. NEVER commit .env — this repo is public.

# Twilio (Console → Account Info). Use test credentials for development.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Your Twilio number in E.164. +15005550006 is Twilio's magic test number.
TWILIO_PHONE_NUMBER=+15005550006

# Public HTTPS base URL Twilio can reach for webhooks (ngrok/cloudflared/real domain)
PUBLIC_URL=https://example.ngrok.app

# App login + session signing
APP_PASSWORD=change_me
SESSION_SECRET=generate_a_long_random_string

# Web Push (optional). Generate with: npx web-push generate-vapid-keys
# Leave blank to disable push notifications.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Database (docker-compose provides these defaults)
DATABASE_URL=postgres://twiliochat:twiliochat@db:5432/twiliochat
POSTGRES_USER=twiliochat
POSTGRES_PASSWORD=twiliochat
POSTGRES_DB=twiliochat

# Server
PORT=8080

# Where inbound MMS media is stored (mounted as a volume in docker-compose)
MEDIA_DIR=/data/media

# Cost guards on outbound sending. The daily cap is counted in the database,
# so restarting the app does not reset it.
MAX_SENDS_PER_MINUTE=10
MAX_SENDS_PER_DAY=250

# Brute-force guard on the login endpoint
MAX_LOGIN_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
